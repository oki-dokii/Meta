# API Configuration for ContentModerationEnv
# ============================================

# Choose your LLM provider
LLM_PROVIDER=openai  # Options: "openai" or "grok"

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
# MODEL_NAME=gpt-4o-mini
# API_BASE_URL=https://api.openai.com/v1

# Grok Configuration (if using Grok/X.AI)
XAI_API_KEY=your-xai-api-key-here
# GROK_API_KEY=your-grok-api-key-here  # Alternative env var name
# MODEL_NAME=grok-beta
# API_BASE_URL=https://api.x.ai/v1

# For Hugging Face Token (alternative to OPENAI_API_KEY)
# HF_TOKEN=your-huggingface-token-here
